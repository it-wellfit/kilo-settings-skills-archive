{
  "$schema": "https://app.kilo.ai/config.json",
  "reasoning_display": "expanded",
  "terminal_command_display": "expanded",
  "code_edit_display": "expanded",
  "mcp_tool_display": "collapsed",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "printenv *": "allow",
      "man *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "*>*": "ask"
    },
    "external_directory": "ask",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow"
  },
  "model": "kilo/nvidia/nemotron-3.5-super-vl:free",
  "small_model": "kilo/kilo-auto/free",
  "web_search": true,
  "experimental": {
    "batch_tool": true,
    "image_generation": true,
    "native_notebook_tools": true,
    "code_mode": true
  },
  "subagent_model": "kilo/reflection/beam-free",
  "default_agent": "plan",
}