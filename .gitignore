# 儲存庫層級忽略規則

# 建置產物與依賴
node_modules/
target/
*.bundle

# 金鑰與敏感資訊（嚴禁提交）
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
**/secrets/**
**/credentials/**

# 個資與客戶資料
*.csv
*.xlsx
**/customers/**
**/client-data/**

# 作業系統
.DS_Store
Thumbs.db
desktop.ini

# 編輯器與 IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 日誌與暫存
*.log
*.tmp
*.temp

# Git 狀態檔（由 Agent Manager 管理，不納入協作基礎）
.kilo/agent-manager.json
